{
  "name": "recyklacni-asistent",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest --config vitest.config.mjs --configLoader runner",
    "test:run": "vitest run --config vitest.config.mjs --configLoader runner",
    "test:e2e": "npm run build && vite preview --configLoader runner --host 127.0.0.1 --port 4173",
    "smoke": "node tests/http-smoke.js",
    "validate:schedule": "node scripts/validate-schedule.mjs",
    "validate": "npm run typecheck && npm run lint && npm run validate:schedule && npm run test:run && npm run build",
    "build": "vite build --configLoader runner",
    "preview": "vite preview --configLoader runner"
  },
  "dependencies": {
    "@google/genai": "^1.34.0",
    "@google/generative-ai": "^0.24.1",
    "openai": "^6.15.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.5.4",
    "jsdom": "^29.1.1",
    "playwright": "^1.62.0",
    "postcss": "^8.5.24",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^4.1.10"
  }
}
